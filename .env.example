# Copy to .env (yarn setup does this for you). Only this example file is committed.

# Network: testnet (default) or mainnet. mainnet makes doctor, setup and deploy require --confirm-mainnet.
HEDERA_NETWORK=testnet

# Operator account from https://portal.hedera.com (ECDSA). Pays for scripts and the attestor's HCS writes.
HEDERA_OPERATOR_ID=
# Operator ECDSA private key, hex. Never prefix with NEXT_PUBLIC_.
HEDERA_OPERATOR_KEY=

# Encrypted Hardhat deployer key. Set by yarn hardhat:account:import; do not edit by hand.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Attestor signing key for reward claims. Generated by yarn setup; used only by the attest API route.
ATTESTOR_PRIVATE_KEY=

# HCS topic for the score log. Created by yarn setup.
NEXT_PUBLIC_SCORE_TOPIC_ID=

# HTS reward token ID. Written by yarn deploy.
NEXT_PUBLIC_REWARD_TOKEN_ID=

# SaucerSwap V1 router (testnet).
SAUCERSWAP_V1_ROUTER_ID=0.0.19264

# Mirror node REST base URL (testnet).
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
